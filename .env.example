# NOTE: host port 5433 (not 5432) -- a native Postgres service already owns 5432 on this machine.
DATABASE_URL=postgresql+psycopg://corvid:corvid@localhost:5433/corvid_dev
TEST_DATABASE_URL=postgresql+psycopg://corvid:corvid@localhost:5433/corvid_test

ANTHROPIC_API_KEY=
ANTHROPIC_EXTRACTION_MODEL=claude-haiku-4-5

EMBEDDING_PROVIDER=fastembed
EMBEDDING_DIM=384

SCORING_CONFIG_PATH=config/scoring.yaml

CORVID_API_BASE_URL=http://localhost:8000
